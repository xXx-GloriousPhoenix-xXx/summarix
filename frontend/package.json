{
  "name": "summarix",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:frontend",
    "start:frontend": "ng serve",
    "start:backend": "dotnet watch --project ../backend/Summarix.Presentation",
    "start:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"hex(#FFA500),hex(#A855F7)\" \"npm run start:backend\" \"npm run start\"",    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
