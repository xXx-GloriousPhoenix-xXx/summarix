{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Textify": {
    "BaseUrl": "http://localhost:11000",
    "Model": "base",
    "DefaultLanguage": "en",
    "TimeoutMinutes": 10
  },
  "Ollama": {
    "BaseUrl": "http://localhost:12000",
    "Model": "llama3.2",
    "TimeoutMinutes": 5,
    "DefaultSystemPrompt": "You are a professional assistant. Summarize the following video transcript clearly and concisely using bullet points and key takeaways."
  },
  "Pdf": {
    "PageMarginCm": 2.0,
    "DefaultFontSize": 11,
    "TitleFontSize": 20,
    "HeaderFontSize": 14,
    "LineHeight": 1.4,
    "PrimaryColorHex": "#1565C0",
    "TextColorHex": "#37474F",
    "ShowFooterDate": true
  }
}
